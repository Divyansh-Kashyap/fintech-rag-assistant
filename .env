# ==============================================================================
# FinTech RAG Assistant - Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="FinTech RAG Assistant"
HOST=0.0.0.0
PORT=8000

# Security
API_KEY_SECRET=fintech_secret_key_demo_2026
ENABLE_AUTH=false
RATE_LIMIT_PER_MINUTE=60

# LLM Configuration
# Options: "openai", "gemini", "mock" (offline fallback)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=1024

# Embedding Configuration
# Options: "openai", "gemini", "deterministic" (offline fallback)
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Vector Store & Retrieval Configuration
# Options: "memory", "chroma"
VECTOR_STORE_TYPE=memory
PERSIST_DIRECTORY=data/processed

# RAG Pipeline Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_DENSE=10
TOP_K_SPARSE=10
RRF_K=60
TOP_K_RERANK=3
MIN_CONFIDENCE_THRESHOLD=0.45

# Google Drive Sync Configuration
GDRIVE_FOLDER_ID=1CX9szQJMiVBEYPqMnPxixGA8b3nOrWpc

# Streamlit Frontend
BACKEND_API_URL=http://localhost:8000
